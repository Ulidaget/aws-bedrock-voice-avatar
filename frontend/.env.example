# --- Frontend env (public values only; copy to .env) ---

# Backend WebSocket endpoint
VITE_WSS_ENDPOINT=ws://localhost:8080/session

# Cognito (public identifiers — NOT secrets)
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173

# LOCAL DEV ONLY: skip login and connect without a token (backend must also
# run with AUTH_DISABLED=true). Never true in a deployed build.
VITE_AUTH_DISABLED=true

# Optional GLB avatar model URL (Ready Player Me export or similar).
# If empty, a built-in procedural avatar is used.
VITE_AVATAR_MODEL_URL=
