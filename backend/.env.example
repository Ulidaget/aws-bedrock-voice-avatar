# --- Backend voice proxy env (copy to .env for local dev; never commit .env) ---

# Server
HOST=0.0.0.0
PORT=8080

# AWS / Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-2-sonic-v1:0

# AWS credentials for LOCAL dev only (prefer AWS SSO / profiles / env chain).
# The Nova Sonic SDK uses EnvironmentCredentialsResolver, so these must be set
# in the environment when running locally:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...

# Cognito JWT validation (leave blank + AUTH_DISABLED=true for pure local dev)
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# LOCAL DEV ONLY — bypass JWT validation. NEVER set true in AWS.
AUTH_DISABLED=true

# CORS / allowed SPA origin
ALLOWED_ORIGIN=http://localhost:5173

# Max session length in seconds (< Nova Sonic 8-min / 480s stream cap)
MAX_SESSION_SECONDS=450
